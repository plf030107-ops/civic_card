<?xml version="1.0" encoding="utf-8"?>
<!--
  背屏卡片主布局
  目标尺寸 976x596 px @450dpi ≈ 390dp x 238dp

  左栏：车辆状态（门锁大字 + 四门四窗 + 电量里程）
  右栏：四个操作按钮（解锁/上锁/后备箱/寻车）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/card_pad_h"
        android:paddingEnd="@dimen/card_pad_h"
        android:paddingTop="@dimen/card_pad_v"
        android:paddingBottom="@dimen/card_pad_v">

        <!-- ================= 左栏：状态 ================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 车名 + 连接状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCarName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="十代思域"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvConn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● 未连接"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_tiny" />
            </LinearLayout>

            <!-- 门锁大字 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLockIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvLockState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="已锁车"
                    android:textColor="@color/ok"
                    android:textSize="@dimen/text_hero"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 四门四窗矩阵 -->
            <LinearLayout
                android:id="@+id/llDoors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- 左前 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvFL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="左前"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_tiny" />

                    <TextView
                        android:id="@+id/tvFLStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <!-- 右前 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvFR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="右前"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_tiny" />

                    <TextView
                        android:id="@+id/tvFRStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <!-- 左后 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvRL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="左后"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_tiny" />

                    <TextView
                        android:id="@+id/tvRLStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <!-- 右后 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvRR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="右后"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_tiny" />

                    <TextView
                        android:id="@+id/tvRRStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider" />

            <!-- 电量 / 里程 / 温度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBatteryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="电量"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_tiny" />

                    <TextView
                        android:id="@+id/tvBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="续航"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_tiny" />

                    <TextView
                        android:id="@+id/tvRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- km"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="车内"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_tiny" />

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= 右栏：操作 ================= -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- 第一行：解锁 / 上锁 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnUnlock"
                    android:layout_width="@dimen/btn_size"
                    android:layout_height="@dimen/btn_size"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:text="🔓"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnLock"
                    android:layout_width="@dimen/btn_size"
                    android:layout_height="@dimen/btn_size"
                    android:layout_marginStart="@dimen/btn_gap"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- 第二行：后备箱 / 寻车 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/btn_gap"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTrunk"
                    android:layout_width="@dimen/btn_size"
                    android:layout_height="@dimen/btn_size"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:text="🧳"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnFind"
                    android:layout_width="@dimen/btn_size"
                    android:layout_height="@dimen/btn_size"
                    android:layout_marginStart="@dimen/btn_gap"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:text="📍"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- 状态提示条 -->
            <TextView
                android:id="@+id/tvTip"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:maxLines="2"
                android:text=""
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_tiny"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
